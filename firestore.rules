rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Time Record Validator
    function isValidTimeRecord(data) {
      return data.id is string && data.id.size() <= 100 &&
        data.employeeId is string && data.employeeId.size() <= 50 &&
        data.date is string && data.date.size() <= 10 &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
        (!('clockInMorning' in data) || (data.clockInMorning is string && data.clockInMorning.size() <= 10)) &&
        (!('clockOutMorning' in data) || (data.clockOutMorning is string && data.clockOutMorning.size() <= 10)) &&
        (!('clockInAfternoon' in data) || (data.clockInAfternoon is string && data.clockInAfternoon.size() <= 10)) &&
        (!('clockOutAfternoon' in data) || (data.clockOutAfternoon is string && data.clockOutAfternoon.size() <= 10)) &&
        (!('clockIn' in data) || (data.clockIn is string && data.clockIn.size() <= 10)) &&
        (!('clockOut' in data) || (data.clockOut is string && data.clockOut.size() <= 10)) &&
        (!('leaveType' in data) || (data.leaveType in ['none', 'ferie', 'permesso', 'malattia'])) &&
        (!('leaveHours' in data) || (data.leaveHours is number)) &&
        (!('permessoHours' in data) || (data.permessoHours is number)) &&
        (!('permessoMinutes' in data) || (data.permessoMinutes is number)) &&
        (!('clockOutAfternoonNextDay' in data) || (data.clockOutAfternoonNextDay is bool)) &&
        (!('exitDuringTurnStart' in data) || (data.exitDuringTurnStart is string && data.exitDuringTurnStart.size() <= 10)) &&
        (!('exitDuringTurnEnd' in data) || (data.exitDuringTurnEnd is string && data.exitDuringTurnEnd.size() <= 10)) &&
        (!('permessoStart' in data) || (data.permessoStart is string && data.permessoStart.size() <= 10)) &&
        (!('permessoEnd' in data) || (data.permessoEnd is string && data.permessoEnd.size() <= 10));
    }

    // Leave Request Validator
    function isValidLeaveRequest(data) {
      return data.id is string && data.id.size() <= 100 &&
        data.employeeId is string && data.employeeId.size() <= 50 &&
        data.type in ['ferie', 'permesso', 'malattia', 'congedo'] &&
        data.startDate is string && data.startDate.size() <= 10 &&
        data.endDate is string && data.endDate.size() <= 10 &&
        data.hoursPerDay is number &&
        data.status in ['approvato', 'in_attesa', 'rifiutato'] &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 500));
    }

    // Employee Validator
    function isValidEmployee(data) {
      return data.id is string && data.id.size() <= 50 &&
        data.name is string && data.name.size() <= 100;
    }

    // Test connection doc
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Time Records collection
    match /time_records/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;
      allow create: if isValidId(recordId) && isValidTimeRecord(incoming());
      allow update: if isValidId(recordId) && isValidTimeRecord(incoming());
      allow delete: if isValidId(recordId);
    }

    // Leave Requests collection
    match /leave_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if true;
      allow create: if isValidId(requestId) && isValidLeaveRequest(incoming());
      allow update: if isValidId(requestId) && isValidLeaveRequest(incoming());
      allow delete: if isValidId(requestId);
    }

    // Employees collection
    match /employees/{employeeId} {
      allow get: if isValidId(employeeId);
      allow list: if true;
      allow create: if isValidId(employeeId) && isValidEmployee(incoming());
      allow update: if isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isValidId(employeeId);
    }
  }
}
